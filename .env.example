# demo or live (selects which T212_* credentials are used)
ENVIRONMENT=demo
# Cap the equity this strategy manages (useful on the shared demo account to avoid using the full balance)
MAX_CAPITAL=4500

T212_DEMO_API_KEY=your_demo_api_key
T212_DEMO_API_SECRET=your_demo_api_secret
T212_DEMO_BASE_URL=https://demo.trading212.com/api/v0

T212_LIVE_API_KEY=
T212_LIVE_API_SECRET=
T212_LIVE_BASE_URL=https://live.trading212.com/api/v0

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key

TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
